---
import Base from "../layouts/Base.astro";
import { latestWeek, loadWeekFile } from "../lib/week";
import { league } from "../lib/league";

type Row = {
  Team: string;
  Record: string;
  PF: number;
  PA: number;
  FVOA: number;
  "FVOA Rank": number;
  "Yahoo Rank": number;
  "SOR Rank": number;
  "SOS Rank": number;
};

const { week } = latestWeek();
const rows = loadWeekFile<Row[]>("rankings").sort((a, b) => a["FVOA Rank"] - b["FVOA Rank"]);

// Same order as the table columns
const sorts = [
  { key: "fvoa", label: "FVOA" },
  { key: "pf", label: "PF" },
  { key: "pa", label: "PA" },
  { key: "yahoo", label: "Yahoo" },
  { key: "sor", label: "SOR" },
  { key: "sos", label: "SOS" },
];

// No thousands separators: the comma costs a character in every cell and the columns are tight
const pts = (v: number) => String(Math.round(v));
---

<Base title={`Rankings · ${league.league_name}`}>
  <header class="mb-4 flex items-baseline justify-between">
    <h1 class="text-lg font-semibold">Power rankings</h1>
    <p class="text-xs text-slate-500 dark:text-slate-400">Week {week}</p>
  </header>

  <div class="mb-3 flex flex-wrap gap-2">
    {
      sorts.map((s) => (
        <button
          data-sort={s.key}
          aria-pressed={s.key === "fvoa"}
          class="rounded-full bg-slate-200 px-3 py-1 text-xs font-medium text-slate-700 aria-pressed:bg-indigo-600 aria-pressed:text-white dark:bg-slate-800 dark:text-slate-300"
        >
          {s.label}
        </button>
      ))
    }
  </div>

  <!-- Cells never wrap, and the # and Team columns stay pinned if the table has to scroll sideways -->
  <div class="overflow-x-auto rounded-2xl bg-white shadow-sm dark:bg-slate-900">
    <table class="w-full text-xs whitespace-nowrap tabular-nums">
      <thead class="text-left text-slate-500 dark:text-slate-400">
        <tr class="bg-white dark:bg-slate-900">
          <th class="sticky left-0 z-10 w-8 min-w-8 bg-inherit py-3 pr-1 pl-3">#</th>
          <th class="sticky left-8 z-10 bg-inherit px-1.5 py-3">Team</th>
          <th class="px-1.5 py-3">Rec</th>
          <th class="px-1.5 py-3 text-right">FVOA</th>
          <th class="px-1.5 py-3 text-right">PF</th>
          <th class="px-1.5 py-3 text-right">PA</th>
          <th class="px-1.5 py-3 text-right">Yahoo</th>
          <th class="px-1.5 py-3 text-right">SOR</th>
          <th class="py-3 pr-3 pl-1.5 text-right">SOS</th>
        </tr>
      </thead>
      <tbody id="rows">
        {
          rows.map((r, i) => (
            <tr
              data-fvoa={r["FVOA Rank"]}
              data-yahoo={r["Yahoo Rank"]}
              data-sor={r["SOR Rank"]}
              data-sos={r["SOS Rank"]}
              data-pf={-r.PF}
              data-pa={-r.PA}
              data-team={r.Team}
              class="border-t border-slate-100 bg-white data-[mine=true]:bg-indigo-50 dark:border-slate-800 dark:bg-slate-900 dark:data-[mine=true]:bg-indigo-950/40"
            >
              <td class="pos sticky left-0 z-10 w-8 min-w-8 bg-inherit py-3 pr-1 pl-3 text-slate-400">{i + 1}</td>
              <td class="sticky left-8 z-10 bg-inherit px-1.5 py-3 text-sm font-medium">{r.Team}</td>
              <td class="px-1.5 py-3">{r.Record}</td>
              <td class="px-1.5 py-3 text-right">{r.FVOA.toFixed(2)}</td>
              <td class="px-1.5 py-3 text-right">{pts(r.PF)}</td>
              <td class="px-1.5 py-3 text-right">{pts(r.PA)}</td>
              <td class="px-1.5 py-3 text-right">{r["Yahoo Rank"]}</td>
              <td class="px-1.5 py-3 text-right">{r["SOR Rank"]}</td>
              <td class="py-3 pr-3 pl-1.5 text-right">{r["SOS Rank"]}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="mt-3 space-y-1 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
    <p>
      <strong class="text-slate-700 dark:text-slate-300"><em>FVOA</em></strong> is a team's expected
      margin against a historically average team.
    </p>
    <p>
      <strong class="text-slate-700 dark:text-slate-300"><em>PF</em></strong> is points for.
    </p>
    <p>
      <strong class="text-slate-700 dark:text-slate-300"><em>PA</em></strong> is points against.
    </p>
    <p>
      <strong class="text-slate-700 dark:text-slate-300"><em>Yahoo</em></strong> is the team's place
      in the Yahoo standings.
    </p>
    <p>
      <strong class="text-slate-700 dark:text-slate-300"><em>SOR</em></strong> (strength of record)
      is how impressive the record is given the schedule played.
    </p>
    <p>
      <strong class="text-slate-700 dark:text-slate-300"><em>SOS</em></strong> is strength of
      schedule, where 1 is the hardest.
    </p>
  </div>
</Base>

<script>
  const body = document.querySelector<HTMLElement>("#rows")!;
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-sort]");

  function sortBy(key: string) {
    const rows = [...body.querySelectorAll<HTMLTableRowElement>("tr")];
    rows.sort((a, b) => Number(a.dataset[key]) - Number(b.dataset[key]));
    rows.forEach((row, i) => {
      body.appendChild(row);
      row.querySelector(".pos")!.textContent = String(i + 1);
    });
    buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.sort === key)));
  }

  buttons.forEach((b) => b.addEventListener("click", () => sortBy(b.dataset.sort!)));
</script>